{
  "id": "/",
  "name": "Web Utils — Private Developer Tools",
  "short_name": "Web Utils",
  "description": "Free developer tools that run 100% in your browser: JSON, Base64, JWT, regex, epoch, hashes and more. No uploads, works offline.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#08080a",
  "theme_color": "#08080a",
  "lang": "en",
  "dir": "ltr",
  "categories": ["developer", "productivity", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "JSON Formatter", "url": "/tools/json-formatter", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "JWT Debugger", "url": "/tools/jwt-debugger", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Base64", "url": "/tools/base64-encode-decode", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Epoch Converter", "url": "/tools/timestamp-converter", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
